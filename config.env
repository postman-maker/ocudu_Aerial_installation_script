# ============================================================================
# config.env - Site / hardware specific settings for the OCUDU + Aerial 26-1
#              installer on HPE ProLiant Compute DL384 Gen12 (NVIDIA GH200).
#
# Edit every value marked "CHANGE ME" before running install.sh.
# All values are sourced verbatim by install.sh (POSIX/bash syntax).
# ============================================================================

# ---------------------------------------------------------------------------
# 0. Versions / sources
# ---------------------------------------------------------------------------
# CUDA toolkit + datacenter driver (open kernel modules) required by Aerial 26-1.
CUDA_VERSION="12-9"                 # apt meta-package suffix: cuda-toolkit-12-9
DRIVER_BRANCH="open"               # "open" -> nvidia-driver open kernel modules (required on GH200)

# This host runs Ubuntu 26.04 (resolute); NVIDIA has no ubuntu2604 sbsa repo yet,
# so we pin the CUDA/DOCA repo base to ubuntu2404. Leave empty to auto-detect.
NV_UBUNTU_REPO="ubuntu2404"
DOCKER_CODENAME_OVERRIDE="noble"   # Docker has no 'resolute' repo yet -> use noble

# NVIDIA Aerial Framework (open source, GitHub). 26-1 == release/26-1 line.
AERIAL_FRAMEWORK_REPO="https://github.com/NVIDIA/aerial-framework.git"
AERIAL_FRAMEWORK_REF="release/26-1"   # branch/tag to check out (CHANGE ME if tag differs)
AERIAL_FRAMEWORK_DIR="/opt/aerial-framework"

# Optional: Aerial CUDA-Accelerated RAN 26.1 container from NGC (needs an
# NGC API key in NGC_API_KEY). Leave key empty to skip the container pull.
NGC_API_KEY=""                                     # CHANGE ME (or export before running)
AERIAL_CUBB_IMAGE="nvcr.io/nvidia/aerial/aerial-cuda-accelerated-ran:26-1-cubb"  # CHANGE ME to the exact tag you are entitled to

# OCUDU (GitLab, open source). Both CU and DU are built from this tree.
OCUDU_REPO="https://gitlab.com/ocudu/ocudu.git"
OCUDU_REF="main"                    # branch/tag/commit
OCUDU_DIR="/opt/ocudu"
OCUDU_FFT="armpl"                  # FFT backend for ARM64 (GH200). One of: armpl | fftw
OCUDU_SPLIT="SPLIT_7_2"           # DU_SPLIT_TYPE: SPLIT_7_2 (O-RAN FH) | SPLIT_8 | BOTH

# ---------------------------------------------------------------------------
# 1. Network interface plan (4 ports on 2x ConnectX-7 dual-port adapters)
#    Run install.sh with --show-nics to discover names / PCI addresses first.
# ---------------------------------------------------------------------------
# Discovered on dl384 (2026-07-03): ConnectX-7 x2 dual-port on PCI segments
#   0000:01:00.0 enp1s0f0np0 (down)  0000:01:00.1 enp1s0f1np1 (up)
#   0002:01:00.0 enP2s2f0np0 (down)  0002:01:00.1 enP2s2f1np1 (down)
#   enx04ab18f77160 = onboard 1GbE (management, up)
#
# --- Fronthaul (FH): O-RAN split 7.2 to the O-RU. Driven by DPDK + PTP VF. ---
FH_IFNAME="enp1s0f0np0"           # FH PF (down until the O-RU / FH switch is cabled+up)
FH_PCI="0000:01:00.0"             # PCI of the FH PF
FH_VF_PCI="0000:01:00.2"          # expected first VF PCI after 'sriov_numvfs=1' - CONFIRM at runtime (dpdk-devbind.py -s)
FH_RU_MAC="aa:bb:cc:dd:ee:ff"     # CHANGE ME: MAC address of the O-RU fronthaul port
FH_DU_MAC="2c:9d:90:21:21:c2"     # MAC to assign to the DU FH VF (locally-administered; change if it clashes)
FH_VLAN="2"                       # CHANGE ME: C-/U-plane VLAN tag agreed with the RU
FH_MTU="9600"                     # jumbo frames for OFH

# --- NG interface: N2 (NGAP/SCTP -> AMF) + N3 (GTP-U -> UPF) to the 5G core ---
NG_IFNAME="enp1s0f1np1"           # NG port (currently up; CONFIRM this is the core-facing link)
NG_LOCAL_IP="10.60.0.10"          # CHANGE ME: this host's IP on the NG network
NG_PREFIX="24"                    # CHANGE ME: NG subnet prefix length
NG_GATEWAY="10.60.0.1"            # CHANGE ME: gateway toward the core (empty to skip route)
AMF_ADDR="10.60.0.100"            # CHANGE ME: AMF N2 address (5G core)

# --- Management / OAM / SSH: admin, SMO, apt, NGC pulls. ---
MGMT_IFNAME="enx04ab18f77160"     # onboard 1GbE (internet/admin). CONFIRM with: ip route get 8.8.8.8
MGMT_LOCAL_IP=""                  # empty -> keep existing DHCP/static (don't disturb the working admin link)

# --- PTP / timing for fronthaul (LLS-C3: switch = T-GM). Usually the FH port. ---
PTP_IFNAME="${FH_IFNAME}"         # interface carrying PTP/SyncE (default: same as FH PF)
PTP_DOMAIN="24"                   # CHANGE ME: PTP domain agreed with the FH switch/T-GM
# 4th physical port (e.g. enp2s0f1np1) is left as a spare: 2nd FH cell, NG
# redundancy, or a dedicated PTP/timing link. Configure manually if used.

# ---------------------------------------------------------------------------
# 2. Cell / PLMN (DU + CU). Match these to your RU and 5G core.
# ---------------------------------------------------------------------------
PLMN="00101"                      # CHANGE ME
TAC="7"                           # CHANGE ME
DL_ARFCN="634548"                 # CHANGE ME (n78 example)
NR_BAND="78"
CHANNEL_BW_MHZ="100"
COMMON_SCS="30"
PCI="1"

# ---------------------------------------------------------------------------
# 3. CPU / memory tuning (GRUB). Discover cores with: lscpu / install.sh --show-cpu
#    Reserve housekeeping cores for the OS; isolate the rest for RAN threads.
# ---------------------------------------------------------------------------
# Grace = 72 cores (0-71), single NUMA node0. OS keeps 0-3, RAN isolates 4-71.
ISOLATED_CPUS="4-71"              # cores isolated for OCUDU/Aerial threads
HOUSEKEEPING_CPUS="0-3"           # cores left to the OS/kernel
HUGEPAGES_1G="32"                 # number of 1 GiB hugepages to reserve

# F1 (CU<->DU) and E1 (CU-CP<->CU-UP) run over loopback because CU and DU are
# co-located on this host - no physical NIC is consumed for them.
F1_CU_BIND="127.0.10.1"           # CU-CP F1-C / CU-UP F1-U bind (loopback)
F1_DU_BIND="127.0.10.2"           # DU F1-C / F1-U bind (loopback)
